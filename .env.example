# URL canónica del sitio (usada en metadata, sitemap y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://getgreenroutine.com

# Google Analytics 4 — déjalo vacío para no cargar GA4 en absoluto
NEXT_PUBLIC_GA4_ID=

# Interruptor general de anuncios. "false" (o vacío) = ningún script de red se carga.
NEXT_PUBLIC_ADS_ENABLED=false

# Claves del network de anuncios (Adsterra u otro) — solo se usan si NEXT_PUBLIC_ADS_ENABLED=true
NEXT_PUBLIC_ADSTERRA_SCRIPT_SRC=
NEXT_PUBLIC_ADSTERRA_CONTAINER_ID=
